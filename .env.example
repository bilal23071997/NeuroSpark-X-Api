PORT=3001
# Comma-separated origins allowed to call the API (website + admin portal)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

DATABASE_URL=postgres://postgres:postgres@localhost:5432/neurospark_x
# Dev only: auto-create tables from entities. Use migrations in production.
# Managed Postgres (Supabase etc.) needs SSL
DB_SSL=false
DB_SYNCHRONIZE=true
# Max database connections per instance. Use 1 on Vercel (serverless) with the Supabase transaction pooler.
DB_POOL_MAX=10

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# First admin account, created on startup only if the users table is empty
SEED_ADMIN_EMAIL=admin@neurosparkx.com
SEED_ADMIN_PASSWORD=change-me-now

# Set to true when the API runs behind nginx / a load balancer so rate limits use the real client IP
TRUST_PROXY=false
# /docs (Swagger). Leave unset to show it everywhere except production; set false to hide it
SWAGGER_ENABLED=true

# File storage (S3-compatible: Cloudflare R2 or AWS S3). Leave empty and uploads answer 503.
# Product files go under private/ and are never public; images go under public/ and need the public base URL.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public address of the bucket, no trailing slash, e.g. https://cdn.example.com
STORAGE_PUBLIC_BASE_URL=

# Payments (Stripe). Keys are normally entered in the admin portal (Payments screen) and stored encrypted.
# Encryption key for those stored keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENTS_ENCRYPTION_KEY=
# Where buyers return after paying (the website, no trailing slash)
WEBSITE_URL=http://localhost:3000
# Public address of this API, used to show the webhook URL (leave empty to derive it from the request)
API_PUBLIC_URL=
# Optional: set these instead of using the admin screen (they then win, and the screen becomes read-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Shared secret that lets the website tell the API which visitor a request is for (rate limits are per visitor).
# Use the same value on the website. Leave empty and every visitor counts as the website's own address.
INTERNAL_API_KEY=
# Run pending database migrations when the API starts (set false to skip)
DB_MIGRATIONS_RUN=true
